{
  "name": "akno-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Akno — a two-way memory layer for agents over a Markdown knowledge base",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force --emitDeclarationOnly false --noEmit false",
    "akno": "node packages/cli/src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke-demo.mjs",
    "smoke:packages": "pnpm build && node scripts/smoke-packages.mjs",
    "check:repository": "node scripts/check-repository-safety.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write \"packages/**/*.ts\" \"packages/*/README.md\" \"*.{json,md}\" \"docs/*.md\" \"examples/*.md\" \"config/*.jsonc\" \"scripts/*.mjs\" \".changeset/*.md\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"packages/*/README.md\" \"*.{json,md}\" \"docs/*.md\" \"examples/*.md\" \"config/*.jsonc\" \"scripts/*.mjs\" \".changeset/*.md\"",
    "bench": "node packages/cli/src/bin.ts bench",
    "knip": "knip"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^22.10.0",
    "knip": "6.31.0",
    "oxlint": "1.76.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
