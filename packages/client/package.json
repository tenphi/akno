{
  "name": "@tenphi/akno-client",
  "version": "0.3.0",
  "description": "Thin typed client for a running Akno service \u2014 identical interface to @tenphi/akno-core, no native dependencies",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tenphi/akno-protocol": "workspace:*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/akno.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/tenphi/akno#readme",
  "bugs": {
    "url": "https://github.com/tenphi/akno/issues"
  },
  "author": "Andrey Yamanov",
  "scripts": {
    "prepack": "node ../../scripts/pack-assets.mjs"
  }
}
