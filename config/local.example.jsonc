{
  // ───────────────────────────────────────────────────────────────────────────
  // Template for `config/local.jsonc` — which is GITIGNORED and never committed.
  //
  //   cp config/local.example.jsonc config/local.jsonc
  //
  // Only the keys you want to change. Everything else falls through to
  // `config/default.jsonc`. Put nothing secret here: a credential is referenced
  // by env var name (see .env.example), never written into a config file.
  // ───────────────────────────────────────────────────────────────────────────

  // Your knowledge base. Required — there is no sensible default for this.
  "akno_path": "~/Notes",

  // One OpenAI-compatible endpoint can serve every role. A local
  // llama-server / LM Studio / Ollama router takes no auth, so no key is needed.
  "providers": {
    "local": {
      "base_url": "http://127.0.0.1:8080/v1",
      "api_key": null
    }
    // A hosted provider, if you want a stronger model for summaries, fact
    // derivation, or the nightly cycle. The key lives in .env under this name.
    // "openai": {
    //   "base_url": "https://api.openai.com/v1",
    //   "api_key": { "env": "AKNO_OPENAI_API_KEY" }
    // }
  },

  // Model ids as your endpoint reports them — check with `curl $BASE_URL/models`.
  // `akno doctor` tells you which roles resolved and what each missing one costs.
  "models": {
    "embedding": {
      "provider": "local",
      "id": "text-embedding-qwen3-embedding-0.6b",
      // Recorded per vector. Changing it triggers a re-index rather than
      // silently corrupting the index.
      "dimensions": 1024
    },
    "reranker": {
      "provider": "local",
      "id": "bge-reranker-v2-m3",
      "enabled": true
    },
    // Summaries, facts, `remember`, naming, and the nightly cycle. Off the recall
    // path, so the bigger model belongs here.
    "derive": {
      "provider": "local",
      "id": "gemma-4-12b-it"
    },
    // Query expansion only — on the recall path, so keep it fast. Setting it to
    // the same id as `derive` is fine if you only run one model.
    "expansion": {
      "provider": "local",
      "id": "llama-3.2-3b-instruct"
    }
  },

  // Rules can live here, or travel with the notes at <akno_path>/akno.json —
  // which wins over both config files. Glob-scoped, most-specific-wins.
  // `akno rules <path>` prints which rule won and why.
  "folders": {
    // "sources/**": { "role": "source", "remember": "deny", "ingest": "document" },
    // "conversations/**": { "role": "source", "remember": "deny", "rank": 0.5 },
    // "templates/**": { "role": "ignored", "remember": "deny" },
    //
    // An inbox: drop anything here and it files itself. `route: true` is what makes
    // it one, and it is the only place Akno moves files.
    // "inbox/**": { "ingest": "auto", "route": true }
  },

  // Curate only considers pages that explicitly opt in through their own frontmatter.
  // Set `mode` to `audit`, `review`, or `auto` to use durable exact plans for opted-in
  // hygiene and synthesis pages. A proposed split is one atomic parent-and-children
  // item. Null preserves the legacy `write` preview/apply path.
  //
  // The separate `adopt` phase is enabled by default and can create minimal pages
  // for readable documents with no owner. Set `adopt.enabled` false if scheduled
  // maintenance must be report-only.
  "maintenance": {
    "curate": { "enabled": false, "mode": null, "write": false, "verify": true },
    "adopt": { "enabled": true }
  }
}
