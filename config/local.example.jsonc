{
  // ───────────────────────────────────────────────────────────────────────────
  // Template for `config/local.jsonc` — which is GITIGNORED and never committed.
  //
  //   cp config/local.example.jsonc config/local.jsonc
  //
  // Only the keys you want to change. Everything else falls through to
  // `config/default.jsonc`. Put nothing secret here: a credential is referenced
  // by env var name (see .env.example), never written into a config file.
  // ───────────────────────────────────────────────────────────────────────────

  // Your knowledge base. Required — there is no sensible default for this.
  "akno_path": "~/Notes",

  // One OpenAI-compatible endpoint can serve every role. A local
  // llama-server / LM Studio / Ollama router takes no auth, so no key is needed.
  "providers": {
    "local": {
      "base_url": "http://127.0.0.1:8080/v1",
      "api_key": null,
      "api": "chat_completions"
    }
    // A hosted provider, if you want a stronger model for summaries, fact
    // derivation, or the nightly cycle. The key lives in .env under this name.
    // "openai": {
    //   "base_url": "https://api.openai.com/v1",
    //   "api_key": { "env": "AKNO_OPENAI_API_KEY" },
    //   "api": "responses"
    // }
  },

  // Model ids as your endpoint reports them — check with `curl $BASE_URL/models`.
  // `akno doctor` tells you which roles resolved and what each missing one costs.
  "models": {
    "embedding": {
      "provider": "local",
      "id": "text-embedding-qwen3-embedding-0.6b",
      // Recorded per vector. Changing it triggers a re-index rather than
      // silently corrupting the index.
      "dimensions": 1024
    },
    "reranker": {
      "provider": "local",
      "id": "bge-reranker-v2-m3",
      "enabled": true,
      "mode": "endpoint",
      // Learns the model's relevance boundary from invented anchors. Set a
      // measured number only when you deliberately want to override it.
      "score_offset": "auto",
      "exclude_irrelevant": true
    },
    // Summaries, facts, `remember`, naming, and the nightly cycle. Off the recall
    // path, so the bigger model belongs here.
    "derive": {
      "provider": "local",
      "id": "gemma-4-12b-it"
    },
    // Query expansion only — on the recall path, so keep it fast. Setting it to
    // the same id as `derive` is fine if you only run one model.
    "expansion": {
      "provider": "local",
      "id": "llama-3.2-3b-instruct"
    }
  },

  // Minimum hosted setup uses one OpenAI endpoint and credential, but still two
  // models because semantic recall requires an embedding model. Preview and
  // preflight the benchmark-qualified overlay before applying it:
  //
  //   akno init --preset openai-luna --akno-path /path/to/markdown \
  //     --maintenance autonomous --dry-run --check
  //
  // Omit `--dry-run` to create a config. An existing config requires `--force`
  // after inspecting the path-only diff. The preset replaces `providers` and
  // `models` as one unit while preserving unrelated top-level settings:
  //
  // "providers": {
  //   "openai": {
  //     "base_url": "https://api.openai.com/v1",
  //     "api_key": { "env": "AKNO_OPENAI_API_KEY" },
  //     "api": "responses"
  //   }
  // },
  // "models": {
  //   "embedding": {
  //     "provider": "openai",
  //     "id": "text-embedding-3-small",
  //     "dimensions": 1536
  //   },
  //   "reranker": {
  //     "provider": "openai",
  //     "id": "gpt-5.6-luna",
  //     "enabled": true,
  //     "mode": "llm",
  //     "exclude_irrelevant": true,
  //     "top_k": 10,
  //     "max_chars": 800,
  //     "max_output_tokens": 256,
  //     "reasoning_effort": "none"
  //   },
  //   "derive": {
  //     "provider": "openai",
  //     "id": "gpt-5.6-luna",
  //     "reasoning_effort": "low"
  //   },
  //   "expansion": {
  //     "provider": "openai",
  //     "id": "gpt-5.6-luna",
  //     "reasoning_effort": "none"
  //   },
  //   "answer": {
  //     "provider": "openai",
  //     "id": "gpt-5.6-luna",
  //     "max_output_tokens": 1024,
  //     "reasoning_effort": "low"
  //   },
  //   "vision": {
  //     "provider": "openai",
  //     "id": "gpt-5.6-luna",
  //     "enabled": true,
  //     "reasoning_effort": "low"
  //   }
  // },

  // Exact query entities and a few strong lexical page hits seed a bounded
  // two-hop graph candidate arm. Disable this only for retrieval comparisons.
  "recall": {
    "graph": true
  },

  // Optional model-assisted disambiguation for exact-name collisions. Run
  // `akno bench entities` first; failures and uncertain cases stay ambiguous.
  // "graph": {
  //   "contextual_resolution": { "enabled": true }
  // },

  // Rules can live here, or travel with the notes at <akno_path>/akno.jsonc —
  // which wins over both config files. Glob-scoped, most-specific-wins.
  // `akno rules <path>` prints which rule won and why.
  "folders": {
    // "sources/**": { "role": "source", "remember": "deny", "ingest": "document" },
    // "conversations/**": { "role": "source", "remember": "deny", "rank": 0.5 },
    // "templates/**": { "role": "ignored", "remember": "deny" },
    //
    // An inbox: drop anything here and it files itself. `route: true` is what makes
    // it one, and it is the only place Akno moves files.
    // "inbox/**": { "ingest": "auto", "route": true }
  },

  // Prefer one named profile for a scheduled cycle: `audit`, `review`, or `autonomous`.
  // A named profile enables plan-backed curation/adoption, routes enabled observe/reflect
  // phases through the same lifecycle, and supplies the default policy for every transformation.
  // A full policy-backed run seals every enabled phase plan before its first curator call/write.
  // Individual `policies` may lower a class to off/audit/review.
  // Curate only considers pages that explicitly opt in through their own frontmatter.
  // Splits, extractions, merges, and contradiction handling use the same atomic item
  // and curator path. Contradiction writes require
  // every affected page to opt into `dream: synthesize`; qualified rewrites additionally
  // require exact scope evidence.
  //
  // The separate `adopt` phase plans minimal filing pages for readable documents with no owner.
  "maintenance": {
    "profile": "audit",
    "policies": {},
    "limits": {
      "max_items": 30,
      "max_files_changed": 40,
      "max_bytes_written": 500000,
      "max_high_risk_items": 3
    },
    "curate": { "verify": true },
    "conflicts": { "enabled": true, "verify": true, "resolve": true },
    "adopt": { "max_pages": 20 }
  }
}
